--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -35,6 +35,7 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IOUserClient.h>
 #include <libkern/c++/OSAllocation.h>
+#include <libkern/c++/OSSymbol.h>
 
 extern "C" {
 #include <libkern/amfi/amfi.h>
@@ -110,6 +111,33 @@
 kern_return_t
 IOKitBSDInit( void )
 {
+	/* Console bring-up: publish the prelinked ApplePMGRNub class so AMFI finds a
+	 * PMGR provider. The provider slot is cleared, which makes the original read
+	 * stub return 0xffffffff and the write stub a no-op. Opt-in boot argument.
+	 */
+	{
+		int sheng_pmgr_stub = 0;
+		if (PE_parse_boot_argn("sheng-pmgr-stub", &sheng_pmgr_stub, sizeof(sheng_pmgr_stub)) && sheng_pmgr_stub) {
+			OSMetaClass *meta = OSMetaClass::getMetaClassWithName(OSSymbol::withCString("ApplePMGRNub"));
+			if (meta == nullptr) {
+				IOLog("sheng-pmgr-stub: ApplePMGRNub class missing\n");
+			} else {
+				IOService *nub = (IOService *)meta->alloc();
+				if (nub == nullptr) {
+					IOLog("sheng-pmgr-stub: alloc failed\n");
+				} else {
+					*(void **)((char *)nub + 0x440) = nullptr;
+					if (!nub->init()) {
+						IOLog("sheng-pmgr-stub: init failed\n");
+						nub->release();
+					} else {
+						nub->registerService();
+						IOLog("sheng-pmgr-stub: ApplePMGRNub published\n");
+					}
+				}
+			}
+		}
+	}
 	IOService::publishResource("IOBSD");
 
 #if IOPOLLED_COREFILE
