+				if (nub == nullptr) {
+					panic("SHENG-PMGR-STUB: late hook, alloc failed");
+				} else {
+					uintptr_t slot = (uintptr_t)nub + 0x440;
+					*(void **)slot = nullptr;
+					if (!nub->init()) {
+						panic("SHENG-PMGR-STUB: late hook, init failed");
+					} else {
+						nub->registerService();
+						panic("SHENG-PMGR-STUB: late hook, published");
