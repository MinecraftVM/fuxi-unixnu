--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -45,6 +45,7 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IOMessage.h>
 #include <IOKit/IOLib.h>
+#include <kern/debug.h>
 #include <IOKit/IOKitKeysPrivate.h>
 #include <IOKit/IOBSD.h>
 #include <IOKit/IOUserClient.h>
@@ -488,6 +489,29 @@
 
 	PE_parse_boot_argn("dextrelaunch", &gIODextRelaunchMax, sizeof(gIODextRelaunchMax));
 	PE_parse_boot_argn("iocthreads", &gMaxConfigThreads, sizeof(gMaxConfigThreads));
+
+	/* Console bring-up: publish the prelinked ApplePMGRNub class before AMFI runs,
+	 * with the provider slot cleared so the original read/write stubs are safe.
+	 */
+	{
+		int sheng_pmgr_stub_value = 0;
+		if (PE_parse_boot_argn("sheng-pmgr-stub", &sheng_pmgr_stub_value, sizeof(sheng_pmgr_stub_value)) && sheng_pmgr_stub_value) {
+			const OSMetaClass *meta = OSMetaClass::getMetaClassWithName(OSSymbol::withCString("ApplePMGRNub"));
+			if (meta == nullptr) {
+				panic("SHENG-PMGR-STUB: early hook, ApplePMGRNub class missing");
+			}
+			IOService *nub = (IOService *)meta->alloc();
+			if (nub == nullptr) {
+				panic("SHENG-PMGR-STUB: early hook, alloc failed");
+			}
+			*(void **)(uintptr_t)((char *)nub + 0x440) = nullptr;
+			if (!nub->init()) {
+				panic("SHENG-PMGR-STUB: early hook, init failed");
+			}
+			nub->registerService();
+			panic("SHENG-PMGR-STUB: early hook, published");
+		}
+	}
 
 	gIOUserClientClassKey = OSSymbol::withCStringNoCopy( kIOUserClientClassKey );
 
